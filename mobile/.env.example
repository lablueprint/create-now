# Copy to .env.local and fill in. Get local values with `npm run db:status` from the repo root.
# EXPO_PUBLIC_* variables are bundled into the app and visible to anyone: never put secret keys here.

# Supabase API URL.
#   iOS simulator:     http://127.0.0.1:54321
#   Android emulator:  http://10.0.2.2:54321
#   Physical device:   http://<your-laptop-LAN-IP>:54321  (same Wi-Fi network)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable key (sb_publishable_...). Safe for the client; access is enforced by RLS.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
